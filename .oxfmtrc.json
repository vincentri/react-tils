{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "ignorePatterns": [
    "dist",
    "pnpm-lock.yaml",
    "eval/out",
    "examples/*/.next",
    "examples/*/next-env.d.ts",
    "eval/fixtures/RESULTS.md",
    "eval/fixtures/results.json",
    "eval/results-realistic.md",
    "demo/src/browser-support.json",
    "demo/src/compare.json"
  ]
}
