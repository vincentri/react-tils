{
  "compilerOptions": {
    "target": "es2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "@vincent.ri/react-tils": ["../src/index.ts"]
    }
  },
  "include": ["src", "prerender.ts", "vite.config.ts", "../e2e", "../e2e-next", "../e2e-mobile"]
}
